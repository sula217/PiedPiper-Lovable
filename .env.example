# Server-only. Never prefix these Gemini variables with NEXT_PUBLIC_.
GEMINI_API_KEY=your-google-ai-studio-key
# Preferred cost-efficient model (verified for this project on 2026-11-14).
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Tried only when the preferred model fails in a model-specific way
# (404, timeouts/5xx after bounded retries, or a per-model quota) and is not
# itself cooling down. Default: gemini-3.5-flash (or gemini-3.5-flash-lite when
# GEMINI_MODEL is something else). Set to "none" to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Optional: enable real accounts after applying supabase/migrations/001-003.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enable real-data AI processing only after reviewing your provider/data agreement.
ALLOW_REAL_AI_PROCESSING=false
# Photo analysis for "Let Piper Understand Your Interests". Keep false on the
# free tier: enable only with a provider configuration suitable for personal data.
ALLOW_PHOTO_ANALYSIS=false
# Optional live OpenStreetMap place discovery (Overpass). The curated US
# (NYC, SF, Chicago, Austin) dataset always works without it. Cached 24 h.
PLACES_OSM_LIVE=false
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional: process-wide hourly cap on anonymous AI requests (default 600).
# GUEST_AI_HOURLY_LIMIT=600
